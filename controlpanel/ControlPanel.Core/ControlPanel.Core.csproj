<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Control Panel's logic and view-models. Plain .NET (no WPF) so it can be tested;
       the window project (ControlPanel) binds to the view-models here. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ControlPanel.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Server updates: the signed manifest, the signature check and the saved versions. -->
  <ItemGroup>
    <ProjectReference Include="..\Reborn.Update\Reborn.Update.csproj" />
  </ItemGroup>

  <!-- The friend's guide in each friend zip (README-<name>.txt), as tools/package.py uses it. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\FRIEND-SETUP.md" LogicalName="FRIEND-SETUP.md" Link="FRIEND-SETUP.md" />
  </ItemGroup>

</Project>
