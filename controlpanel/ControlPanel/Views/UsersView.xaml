<UserControl x:Class="ControlPanel.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- One table row (and the header): the same column widths for both. -->
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="HeaderCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="4,12,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Adding a player: name, may they start games, a key. -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Add a player" Style="{StaticResource SectionTitle}" />
                <WrapPanel>
                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="Name (as they type it in the game)" Style="{StaticResource NoteText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Width="220" MaxLength="24"
                                 AutomationProperties.Name="New player name" />
                    </StackPanel>
                    <CheckBox Content="Can create games" IsChecked="{Binding NewCanCreate}" VerticalAlignment="Bottom" Margin="0,0,16,8" />
                    <Button Content="Generate Key" Command="{Binding GenerateKeyCommand}" VerticalAlignment="Bottom" Margin="0,0,12,8" />
                    <StackPanel Margin="0,0,16,8" VerticalAlignment="Bottom">
                        <TextBlock Text="Key" Style="{StaticResource NoteText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding PreviewKey, Mode=OneWay}" IsReadOnly="True" Width="260" AutomationProperties.Name="New player key"
                                 FontFamily="Consolas" ToolTip="Press Generate Key. A new key is made on every press until you save." />
                    </StackPanel>
                    <Button Content="Save" Command="{Binding SaveCommand}" Style="{DynamicResource AccentButtonStyle}"
                            MinWidth="90" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- The switch for the whole server. -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <!-- Off and unusable while there is no user list: then anyone can join (the note says so). -->
            <CheckBox Content="Require keys to join" IsChecked="{Binding RequireKeys, Mode=OneWay}" IsEnabled="{Binding HasUserList}"
                      Command="{Binding ToggleRequireKeysCommand}" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource NoteText}" Margin="28,2,0,0"
                       Text="On: a player needs their name and their key (from their zip) to join. Off: a name is enough. Starting a game always needs &quot;Can create games&quot;." />
            <TextBlock Text="{Binding NoListNote}" Style="{StaticResource NoteText}" Margin="28,4,0,0" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                       Visibility="{Binding NoListNote, Converter={StaticResource TextToVisibility}}" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding Message}" Style="{StaticResource MessageText}" FontWeight="SemiBold" />

        <!-- Everyone who can join: a plain table (no row selection, so the buttons stay readable).
             Header and rows share their column widths (SharedSizeGroup), so a wider row, such as one
             with "Confirm name", widens that column for all. In a narrow window the table scrolls
             sideways rather than cutting off the buttons. -->
        <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource Card}" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <Grid Margin="0,4,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="170" SharedSizeGroup="UserName" />
                            <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="UserCreate" />
                            <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="UserKey" />
                            <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="UserZip" />
                            <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="UserSeen" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="UserActions" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource HeaderCell}" />
                        <TextBlock Grid.Column="1" Text="Can create games" Style="{StaticResource HeaderCell}" />
                        <TextBlock Grid.Column="2" Text="Key made" Style="{StaticResource HeaderCell}" />
                        <TextBlock Grid.Column="3" Text="Zip made" Style="{StaticResource HeaderCell}" />
                        <TextBlock Grid.Column="4" Text="Last seen" Style="{StaticResource HeaderCell}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Users}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="170" SharedSizeGroup="UserName" />
                                            <ColumnDefinition Width="Auto" MinWidth="130" SharedSizeGroup="UserCreate" />
                                            <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="UserKey" />
                                            <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="UserZip" />
                                            <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="UserSeen" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="UserActions" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Cell}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding NameNote}" Margin="8,0,0,0" FontStyle="Italic" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       Visibility="{Binding NameNote, Converter={StaticResource TextToVisibility}}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding CanCreateGames, Mode=OneWay}" Command="{Binding ToggleCreateCommand}"
                                                  AutomationProperties.Name="{Binding Name, StringFormat=Can create games: {0}}"
                                                  Margin="8,0" VerticalAlignment="Center"
                                                  ToolTip="Can this player start new games? Changes at once; no new zip needed." />
                                        <TextBlock Grid.Column="2" Text="{Binding KeyMadeText}" Style="{StaticResource Cell}" />
                                        <TextBlock Grid.Column="3" Text="{Binding ZipMadeText}" Style="{StaticResource Cell}" />
                                        <TextBlock Grid.Column="4" Text="{Binding LastSeenText}" Style="{StaticResource Cell}" />
                                        <StackPanel Grid.Column="5" Margin="8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Off on a "confirm name" row: the stored name is only a label until confirmed. -->
                                                <Button Content="Make zip" Command="{Binding MakeZipCommand}" Margin="0,0,6,0"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=Make zip: {0}}"
                                                        AutomationProperties.HelpText="{Binding MakeZipNote}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        ToolTip="Make the zip to send this player (the game files plus their name and key). On a 'confirm name' row, confirm their name first." />
                                                <Button Content="{Binding RenameLabel}" Command="{Binding RenameCommand}" Margin="0,0,6,0"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=Rename: {0}}" />
                                                <Button Content="New key" Command="{Binding NewKeyCommand}" Margin="0,0,6,0"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=New key: {0}}"
                                                        ToolTip="Replace their key. Their old zip stops working." />
                                                <Button Content="Remove" Command="{Binding RevokeCommand}"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=Remove: {0}}"
                                                        ToolTip="Remove this player. Their key stops working at once." />
                                            </StackPanel>
                                            <TextBlock Text="{Binding MakeZipNote}" Style="{StaticResource NoteText}" Margin="0,4,0,0"
                                                       Visibility="{Binding MakeZipNote, Converter={StaticResource TextToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Names that joined a game lately but match nobody on the list, newest first (names only).
             The owner reads a "confirm name" player's real name from here. -->
        <Border Grid.Row="4" Margin="0,12,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Seen recently but not on the list" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource NoteText}" Margin="0,0,0,6"
                           Text="Players who joined a game lately with a name nobody on the list has, newest first. To confirm a name, type it exactly as shown here." />
                <TextBlock Text="{Binding SeenNotListedEmptyText}" Style="{StaticResource NoteText}"
                           Visibility="{Binding SeenNotListedEmptyText, Converter={StaticResource TextToVisibility}}" />
                <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SeenNotListed}" AutomationProperties.Name="Seen recently but not on the list">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,20,2">
                                    <TextBox Text="{Binding Name, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             Padding="0" MinWidth="0" FontWeight="SemiBold" VerticalAlignment="Center"
                                             AutomationProperties.Name="{Binding Name}" ToolTip="Select and copy the name" />
                                    <TextBlock Text="{Binding LastSeenText}" Style="{StaticResource NoteText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Where the zips go. -->
        <DockPanel Grid.Row="5" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Open zip folder" Command="{Binding OpenZipFolderCommand}" Margin="12,0,0,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ZipFolder, StringFormat=Zips are saved in {0}}" Style="{StaticResource NoteText}" />
                <TextBlock Text="{Binding LastZipPath, StringFormat=Last zip made: {0}}" Style="{StaticResource NoteText}"
                           Visibility="{Binding LastZipPath, Converter={StaticResource TextToVisibility}}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
