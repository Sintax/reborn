<UserControl x:Class="ControlPanel.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The installed version, a newer signed release, Update now, the saved versions, and the last result. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="4,12,4,4" MaxWidth="860" HorizontalAlignment="Left">

            <!-- An update that broke off: the one way out, said plainly. -->
            <Border Style="{StaticResource WarningBox}" Margin="0,0,0,12"
                    Visibility="{Binding UnfinishedText, Converter={StaticResource TextToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                            Style="{DynamicResource AccentButtonStyle}"
                            Content="{Binding Unfinished}" ContentStringFormat="Roll back to {0}"
                            AutomationProperties.Name="{Binding Unfinished, StringFormat=Roll back to {0}}"
                            Command="{Binding RollBackCommand}" CommandParameter="{Binding Unfinished}" />
                    <TextBlock Text="{Binding UnfinishedText}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <TextBlock Text="This server" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding CurrentVersion, StringFormat=Installed version: {0}}" FontSize="16" />

            <!-- What GitHub has. -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Available, StringFormat=Update available: {0}}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               Visibility="{Binding Available, Converter={StaticResource TextToVisibility}}" />
                    <TextBlock Text="What's new" FontWeight="SemiBold" Margin="0,8,0,2"
                               Visibility="{Binding Notes, Converter={StaticResource TextToVisibility}}" />
                    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"
                               Visibility="{Binding Notes, Converter={StaticResource TextToVisibility}}" />

                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding Status, Converter={StaticResource TextToVisibility}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Update now" Command="{Binding UpdateNowCommand}" Style="{DynamicResource AccentButtonStyle}"
                                MinWidth="110" Margin="0,0,8,0"
                                Visibility="{Binding Available, Converter={StaticResource TextToVisibility}}"
                                ToolTip="Downloads and checks the update, then the updater saves a copy of this version, stops the servers, swaps the files and starts matchmaking again. If no game shows up, the old version is put back." />
                        <Button Content="Check for updates" Command="{Binding CheckCommand}" MinWidth="110"
                                ToolTip="Looks on GitHub for a newer signed version. The panel also checks when it opens and every 6 hours." />
                    </StackPanel>
                    <TextBlock Text="Working..." Style="{StaticResource NoteText}" Margin="0,6,0,0"
                               Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource NoteText}" Margin="0,8,0,0"
                               Text="The Control Panel closes while it updates and opens again by itself when the update is done." />
                </StackPanel>
            </Border>

            <!-- What the last update or roll back did. -->
            <StackPanel Margin="0,20,0,0" Visibility="{Binding LastResult, Converter={StaticResource TextToVisibility}}">
                <TextBlock Text="Last update" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Visibility="{Binding LastResultOk, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource WarningBox}" Visibility="{Binding LastResultOk, Converter={StaticResource NotBoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LastResultDetails, StringFormat=Details: {0}}" Style="{StaticResource NoteText}" Margin="0,4,0,0"
                                   Visibility="{Binding LastResultDetails, Converter={StaticResource TextToVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Saved versions. Hidden while an update is unfinished: then only the notice's roll back is allowed. -->
            <StackPanel Margin="0,20,0,0" Visibility="{Binding UnfinishedText, Converter={StaticResource NoTextToVisibility}}">
                <TextBlock Text="Saved versions" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource NoteText}" Margin="0,0,0,8"
                           Text="Each update keeps a copy of the version it replaced (the last 3). Going back restarts the server." />
                <TextBlock Text="No earlier versions are kept yet." Style="{StaticResource NoteText}"
                           Visibility="{Binding Kept.Count, Converter={StaticResource ZeroToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Kept}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="12,6" Margin="0,0,0,6" MaxWidth="420" HorizontalAlignment="Left">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Roll back" CommandParameter="{Binding}" Margin="16,0,0,0"
                                            AutomationProperties.Name="{Binding StringFormat=Roll back to {0}}"
                                            Command="{Binding DataContext.RollBackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    <TextBlock Text="{Binding}" FontSize="16" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
