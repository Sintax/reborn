<UserControl x:Class="ControlPanel.Views.PortsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="4,12,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The list being edited. -->
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <TextBlock Text="Game ports" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource NoteText}" Margin="0,0,0,10"
                           Text="Each game that runs at the same time needs its own UDP port. One more port means one more game at once." />

                <ItemsControl ItemsSource="{Binding Ports}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="12,6" Margin="0,0,0,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Remove" CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding StringFormat=Remove port {0}}"
                                            Command="{Binding DataContext.RemovePortCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                    <TextBlock Text="{Binding StringFormat=UDP {0}}" FontSize="16" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddPortCommand}" MinWidth="70" Margin="8,0,0,0" />
                    <TextBox Text="{Binding NewPort, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="New port"
                             ToolTip="A port number, for example 7780">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddPortCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Save" Command="{Binding SaveCommand}" Style="{DynamicResource AccentButtonStyle}" MinWidth="90" Margin="0,0,8,0"
                            ToolTip="Keep this list for matchmaking's next start, and let players in through Windows Firewall (Windows asks first)." />
                    <Button Content="Restart matchmaking" Command="{Binding RestartCommand}"
                            ToolTip="Stops every game and starts matchmaking again with the saved ports." />
                </StackPanel>
                <TextBlock Text="Working..." Style="{StaticResource NoteText}" Margin="0,6,0,0"
                           Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="You have changes that are not saved yet." Margin="0,6,0,0" FontWeight="SemiBold"
                           Visibility="{Binding HasChanges, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- What it means: messages, warnings, memory, the hosting company reminder. -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Message}" Style="{StaticResource MessageText}" FontWeight="SemiBold" Margin="0,0,0,8" />

                <Border Style="{StaticResource WarningBox}" Visibility="{Binding RestartNote, Converter={StaticResource TextToVisibility}}">
                    <TextBlock Text="{Binding RestartNote}" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource WarningBox}" Visibility="{Binding Warning, Converter={StaticResource TextToVisibility}}">
                    <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="Memory" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                <TextBlock Text="{Binding MemoryText}" TextWrapping="Wrap" />
                <Border Style="{StaticResource WarningBox}" Visibility="{Binding MemoryWarning, Converter={StaticResource TextToVisibility}}">
                    <TextBlock Text="{Binding MemoryWarning}" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="Hosting company" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                <TextBlock Text="{Binding Reminder}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
