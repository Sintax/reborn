<Window x:Class="ControlPanel.AskTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battleborn Reborn Control Panel"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Question" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBox x:Name="Answer" MaxLength="24" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="90" Margin="0,0,8,0" Click="Ok_Click"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
